<Window x:Class="ESeriesSwitch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ESeriesSwitch"
        xmlns:loc="clr-namespace:ESeriesSwitch.Localization"
        mc:Ignorable="d"
        Title="E-Series ⇄ ISTA+ Switch"
        Icon="Assets/app.ico"
        Width="600" SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="28,24,28,24">

        <!-- Header -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="E-Series ⇄ ISTA+ Switch" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="EnglishButton" Content="EN" MinWidth="44" Padding="8,4" Click="English_Click"
                        ToolTip="English"/>
                <Button x:Name="HungarianButton" Content="HU" MinWidth="44" Padding="8,4" Margin="6,0,0,0"
                        Click="Hungarian_Click" ToolTip="Magyar"/>
            </StackPanel>
        </Grid>
        <TextBlock Margin="0,4,0,22" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="{Binding [Subtitle], Source={x:Static loc:Loc.Instance}}"/>

        <!-- Update available -->
        <Border x:Name="UpdateBanner" Visibility="Collapsed" Margin="0,-8,0,16" Padding="14,10"
                CornerRadius="6" BorderThickness="1"
                Background="{StaticResource UpdateBackgroundBrush}"
                BorderBrush="{StaticResource UpdateBorderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="UpdateText" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                <Button Grid.Column="1" Style="{DynamicResource AccentButtonStyle}" Click="DownloadUpdate_Click"
                        Content="{Binding [Download], Source={x:Static loc:Loc.Instance}}"/>
                <Button Grid.Column="2" Margin="6,0,0,0" Padding="10,4" Content="✕" Click="DismissUpdate_Click"
                        ToolTip="{Binding [Hide], Source={x:Static loc:Loc.Instance}}"/>
            </Grid>
        </Border>

        <!-- Status card -->
        <Border CornerRadius="8" BorderThickness="1" Padding="0"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border x:Name="StatusStripe" CornerRadius="8,0,0,8" Background="{StaticResource MixedBrush}"/>

                <StackPanel Grid.Column="1" Margin="20,18,20,18">
                    <TextBlock FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{Binding [CurrentlyActive], Source={x:Static loc:Loc.Instance}}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Ellipse x:Name="StatusDot" Width="14" Height="14" VerticalAlignment="Center"
                                 Fill="{StaticResource MixedBrush}"/>
                        <TextBlock x:Name="StatusTitle" Margin="10,0,0,0" FontSize="22" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Text="{Binding [Loading], Source={x:Static loc:Loc.Instance}, Mode=OneTime}"/>
                    </StackPanel>
                    <TextBlock x:Name="StatusSubtitle" Margin="24,4,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                    <Separator Margin="0,16,0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="ediabas_config_dir" FontFamily="Consolas" Margin="0,0,16,6"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="ConfigDirText" Grid.Column="1" FontFamily="Consolas"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>

                        <TextBlock Grid.Row="1" Text="PATH" FontFamily="Consolas" Margin="0,0,16,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="PathText" Grid.Row="1" Grid.Column="1" FontFamily="Consolas"
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- EDIABAS interface (EDIABAS.INI) -->
        <Border x:Name="InterfaceCard" Margin="0,12,0,0" CornerRadius="8" BorderThickness="1" Padding="20,16"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <StackPanel>
                <TextBlock FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding [InterfaceHeader], Source={x:Static loc:Loc.Instance}}"/>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="InterfaceTitle" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="InterfaceValue" Grid.Column="1" FontFamily="Consolas" FontSize="12"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </Grid>

                <!-- Interface choice: the active one is highlighted -->
                <UniformGrid Rows="1" Margin="0,10,0,0">
                    <Button x:Name="IcomButton" Margin="0,0,4,0" HorizontalAlignment="Stretch" Click="Interface_Click"
                            Tag="Icom" Content="ICOM"/>
                    <Button x:Name="EnetButton" Margin="4,0,4,0" HorizontalAlignment="Stretch" Click="Interface_Click"
                            Tag="Enet" Content="ENET"/>
                    <Button x:Name="KDcanButton" Margin="4,0,4,0" HorizontalAlignment="Stretch" Click="Interface_Click"
                            Tag="KDcan" Content="K+DCAN"/>
                    <Button x:Name="OfflineButton" Margin="4,0,0,0" HorizontalAlignment="Stretch" Click="Interface_Click"
                            Tag="Offline" Content="{Binding [ButtonOffline], Source={x:Static loc:Loc.Instance}}"/>
                </UniformGrid>

                <TextBlock x:Name="LoadWin64Warning" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                           Foreground="{StaticResource ESeriesBrush}" Visibility="Collapsed"/>

                <!-- ENET: cable (ports 6811/6801) or ICOM Next (ports 50161/50160) -->
                <Grid x:Name="EnetVariantRow" Margin="0,12,0,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Margin="0,0,12,0"
                               Text="{Binding [EnetVariantLabel], Source={x:Static loc:Loc.Instance}}"/>
                    <UniformGrid Grid.Column="1" Rows="1">
                        <Button x:Name="EnetCableButton" Margin="0,0,4,0" HorizontalAlignment="Stretch"
                                Tag="Cable" Click="EnetVariant_Click"
                                Content="{Binding [EnetCable], Source={x:Static loc:Loc.Instance}}"/>
                        <Button x:Name="EnetIcomButton" Margin="4,0,0,0" HorizontalAlignment="Stretch"
                                Tag="Icom" Click="EnetVariant_Click" Content="ICOM Next"/>
                    </UniformGrid>
                </Grid>
                <TextBlock x:Name="EnetPortsText" Margin="0,4,0,0" FontFamily="Consolas" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Visibility="Collapsed"/>

                <!-- Address (ICOM IP / ENET RemoteHost / K+DCAN COM port), read from the INI every time -->
                <Grid x:Name="HostRow" Margin="0,12,0,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="HostLabel" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBox x:Name="HostBox" Grid.Column="1" FontFamily="Consolas" VerticalContentAlignment="Center"
                             TextChanged="HostBox_TextChanged" KeyDown="HostBox_KeyDown"/>
                    <Button x:Name="SaveHostButton" Grid.Column="2" Margin="8,0,0,0" MinWidth="80"
                            Style="{DynamicResource AccentButtonStyle}" Click="SaveHost_Click"
                            Content="{Binding [Save], Source={x:Static loc:Loc.Instance}}"/>
                </Grid>
                <TextBlock x:Name="HostStatus" Margin="0,6,0,0" FontSize="12" Visibility="Collapsed"/>
                <TextBlock x:Name="InterfaceHint" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- Warnings -->
        <Border x:Name="WarningBox" Visibility="Collapsed" Margin="0,12,0,0" Padding="14,10"
                CornerRadius="6" BorderThickness="1"
                Background="{StaticResource WarningBackgroundBrush}"
                BorderBrush="{StaticResource WarningBorderBrush}">
            <TextBlock x:Name="WarningText" TextWrapping="Wrap"/>
        </Border>

        <!-- Switch buttons -->
        <Button x:Name="ToESeriesButton" Margin="0,20,0,0" Height="48" FontSize="15"
                HorizontalAlignment="Stretch" Style="{DynamicResource AccentButtonStyle}"
                Content="{Binding [SwitchToESeries], Source={x:Static loc:Loc.Instance}}"
                Click="ToESeries_Click"/>
        <Button x:Name="ToIstaButton" Margin="0,10,0,0" Height="48" FontSize="15"
                HorizontalAlignment="Stretch" Style="{DynamicResource AccentButtonStyle}"
                Content="{Binding [SwitchToIsta], Source={x:Static loc:Loc.Instance}}"
                Click="ToIsta_Click"/>

        <!-- Restart banner -->
        <Border x:Name="RebootBanner" Visibility="Collapsed" Margin="0,16,0,0" Padding="14,10"
                CornerRadius="6" BorderThickness="1"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"
                           Text="{Binding [RebootRecommended], Source={x:Static loc:Loc.Instance}}"/>
                <Button Grid.Column="1" Click="Reboot_Click"
                        Content="{Binding [RestartNow], Source={x:Static loc:Loc.Instance}}"/>
            </Grid>
        </Border>

        <!-- Footer -->
        <Grid Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button Click="Refresh_Click"
                    Content="{Binding [Refresh], Source={x:Static loc:Loc.Instance}}"/>
            <Button Grid.Column="1" Margin="8,0,0,0" Click="OpenBackups_Click"
                    Content="{Binding [OpenBackups], Source={x:Static loc:Loc.Instance}}"/>
            <Button Grid.Column="2" Margin="8,0,0,0" Click="About_Click"
                    Content="{Binding [About], Source={x:Static loc:Loc.Instance}}"/>
            <TextBlock x:Name="VersionText" Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center"
                       FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
        </Grid>

        <!-- Branding -->
        <Separator Margin="0,18,0,10"/>
        <TextBlock HorizontalAlignment="Center" FontSize="12"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
            <Run Text="{Binding [MadeBy], Source={x:Static loc:Loc.Instance}, Mode=OneWay}"/>
            <Run Text="BimmerDock" FontWeight="SemiBold"/>
            <Run Text="·"/>
            <Hyperlink NavigateUri="https://bimmerdock.com" RequestNavigate="Link_RequestNavigate">bimmerdock.com</Hyperlink>
            <Run Text="·"/>
            <Hyperlink NavigateUri="https://github.com/BimmerDock/ESeriesSwitch" RequestNavigate="Link_RequestNavigate">GitHub</Hyperlink>
        </TextBlock>
    </StackPanel>
</Window>
